# 生产环境变量（脱敏副本）
# 真实值只保存在服务器 /root/servers5a3-upstream/runtime/docker/server.env。
# 本仓库是公开的，已脱敏：
#   <PUBLIC_IP>      公网 IP
#   <INTERNAL_IP>    容器监听/网关 IP
#   <DB_HOST>        数据库容器地址
#   <DB_PASSWORD>    账号库密码
#   <PLAYER_ADMIN_SECRET>  GM/管理密钥

DNFBRIDGE_GUILD_SOLO_CREATE=true
DNFBRIDGE_CHANNEL_LISTEN=<INTERNAL_IP>:7001
DNFBRIDGE_GAME_LISTEN_HOST=<INTERNAL_IP>
DNFBRIDGE_SERVER_IP=<PUBLIC_IP>
DNFBRIDGE_CHANNEL_INFO_PATH=data/dnf/channel_info.etc
DNFBRIDGE_PVF_PATH=data/dnf/Script.pvf
DNFBRIDGE_CHANNEL_INFO_BODY_MODE=latest
DNFBRIDGE_CHANNEL_SERVER_INDEX=0
DNFBRIDGE_CHANNEL_ADVERTISE_SERVER_INDEX=1
DNF_SCRIPT_VERSION=59
DNFBRIDGE_CURRENT_CLIENT_VERSION=official-24.9
DNFBRIDGE_DEFAULT_GROUP_LOGIN_ONLY=false
DNFBRIDGE_GAME_UPPER_HEADER=server16
DNFBRIDGE_GAME_UPPER_BODY_CODEC=plaintext
DNFBRIDGE_GAME_UPPER_CLIENT_BODY_CODEC=plaintext
DNFBRIDGE_DPROTO_MODE=legacy_patch
DNFBRIDGE_PARTY_UDP_RELAY_MODE=embedded
DNFBRIDGE_PARTY_UDP_RELAY_PORT_START=30000
DNFBRIDGE_PARTY_UDP_RELAY_PORT_COUNT=64
DNFBRIDGE_ACCOUNT_API_LISTEN=<INTERNAL_IP>:17002
DNFBRIDGE_ACCOUNT_API_DSN=dnf:<DB_PASSWORD>@tcp(<DB_HOST>:3306)/dnf_local?parseTime=true&charset=utf8mb4,utf8
DNFBRIDGE_ACCOUNT_API_ALLOW_REGISTER=true
DNFBRIDGE_ACCOUNT_API_LOGIN_TOKEN=true
DNFBRIDGE_PACKET_LOG=true
DNFBRIDGE_JOUST_EVENT_ENABLED=false
GOMEMLIMIT=4GiB
TZ=Asia/Shanghai
DNFBRIDGE_PLAYER_ADMIN_SECRET=<PLAYER_ADMIN_SECRET>
DNFBRIDGE_GM_MAIL_OPTIONS=on
DNFBRIDGE_BUFF_SWAP_REAPPLY=on
DNFBRIDGE_RECONNECT_SERIA_ORIGIN=false
DNFBRIDGE_ABYSS_EPIC_WINDOW=legacy
DNFBRIDGE_INVENTORY_SAVE_SCOPE=slot
DNFBRIDGE_PARTY_UDP_RELAY_ENABLED=true
DNFBRIDGE_PARTY_UDP_RELAY_PROBE_LISTEN=on
DNFBRIDGE_PARTY_UDP_RELAY_SEED_FORWARD=on
DNFBRIDGE_PARTY_UDP_RELAY_PROBE_PORTS=2311,2312,30000
DNFBRIDGE_PARTY_UDP_RELAY_DATAGRAM_TRACE=off
DNFBRIDGE_PARTY_DUNGEON_PEER_POSITION=off
DNFBRIDGE_PARTY_DUNGEON_PEER_ACTOR_PRE_REMOVE=off
DNFBRIDGE_MYSQL_INSERT_BATCH=200
DNFBRIDGE_GUILD_ESSENCE_ENABLED=on
DNFBRIDGE_PARTY_ENTRY_BATCH_ACTORS=on
DNFBRIDGE_WHISPER_NATIVE=on
DNFBRIDGE_PARTY_ACTOR_LEAVE_OP26=off
DNFBRIDGE_FIENDWAR_DIRECT_CHANNEL=on

# 2026-10-31：图内换队长客户端不重建表（红电脑），先回退到 transfer 档
DNFBRIDGE_PARTY_DUNGEON_LEADER_EXIT=transfer
