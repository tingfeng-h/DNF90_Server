      "image": "dnf90-db-data:20261112",
      "env_file": [
        "database.env"
      ],
      "volumes": [
        "database:/var/lib/mysql"
      ],
      "command": [
        "--bind-address=10.253.90.3",
        "--character-set-server=utf8mb4",
        "--collation-server=utf8mb4_unicode_ci"
