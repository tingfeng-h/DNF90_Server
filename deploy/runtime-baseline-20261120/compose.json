{
  "services": {
    "db": {
      "image": "dnf90-db-data:20261112",
      "env_file": [
        "database.env"
      ],
      "volumes": [
        "database:/var/lib/mysql"
      ],
      "command": [
        "--bind-address=<LAN_IP>",
        "--character-set-server=utf8mb4",
        "--collation-server=utf8mb4_unicode_ci"
      ],
      "networks": {
        "private": {
          "ipv4_address": "<LAN_IP>"
        }
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "20m",
          "max-file": "3"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "healthcheck.sh",
          "--connect",
          "--innodb_initialized"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 30
      },
      "restart": "unless-stopped"
    },
    "server": {
      "image": "servers5a3-upstream:merge-20261111n-test",
      "init": true,
      "stop_grace_period": "45s",
      "user": "0:0",
      "env_file": [
        "server.env"
      ],
      "volumes": [
        "./server:/runtime",
        "./data:/runtime/data/dnf:ro"
      ],
      "depends_on": {
        "db": {
          "condition": "service_healthy"
        }
      },
      "mem_limit": "5905580032",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "20m",
          "max-file": "3"
        }
      },
